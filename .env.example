# Required: create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Check current model names at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Optional: comma-separated backups tried if the main model fails or is rate limited
GROQ_FALLBACK_MODELS=
# Vision model used only for OCR fallback (OCR_ENGINE=vision or paddle missing)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OCR: auto = PaddleOCR if installed, else Groq vision | paddle | vision
OCR_ENGINE=auto

MAX_FILE_MB=10
MAX_PDF_PAGES=10
RATE_LIMIT_PER_MIN=20
